#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing identity — never commit (canonical copy: GitHub Secrets,
# see docs/plans/0005-release-build-ci.md)
/android/*.keystore
!/android/app/geergit-root-helper.keystore.example
/android/keystore.properties

# Widget Preview related
.widget_preview/

# FVM Version Cache
.fvm/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# Local stock boot.img rollback artifact (64MB, per-device)
boot.img
